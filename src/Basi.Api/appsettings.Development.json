{
  /*
   * DEVELOPMENT CONFIGURATION — NOT A SECRET
   *
   * This file is intentionally committed to source control.
   * "basi_dev_password" is a local-development-only credential defined in
   * docker-compose.yml (POSTGRES_PASSWORD). It has no production equivalent.
   *
   * PostgreSQL Port Mapping:
   * docker-compose publishes host port 5433 -> container port 5432
   * (e.g. Host=127.0.0.1;Port=5433) to prevent conflicts with local PostgreSQL (5432).
   *
   * Configuration Precedence Policy:
   * 1. appsettings.Local.json (highest precedence when present; git-ignored)
   * 2. Command Line Arguments
   * 3. Environment Variables (e.g. ConnectionStrings__DefaultConnection)
   * 4. appsettings.Development.json
   * 5. appsettings.json (base)
   *
   * To override locally without modifying this file:
   * - Option A (File): Create appsettings.Local.json (git-ignored, highest precedence).
   * - Option B (Env): Set ConnectionStrings__DefaultConnection (takes precedence when Local JSON is absent).
   */
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=127.0.0.1;Port=5433;Database=basi_dev;Username=basi;Password=basi_dev_password"
  },
  "FrontendUrl": "http://localhost:5173",
  "Google": {
    "ClientId": "REPLACE_WITH_YOUR_GOOGLE_CLIENT_ID",
    "ClientSecret": "REPLACE_WITH_YOUR_GOOGLE_CLIENT_SECRET"
  }
}
