{
  /*
   * DEVELOPMENT CONFIGURATION — NOT A SECRET
   *
   * This file is intentionally committed to source control.
   * "basi_dev_password" is a local-development-only credential defined in
   * docker-compose.yml (POSTGRES_PASSWORD). It has no production equivalent.
   *
   * Production credentials are supplied via environment variables or a secrets
   * manager (never committed to source control). See .env.example for the
   * expected variable names.
   *
   * To override locally without modifying this file, either:
   * 1. Create appsettings.Local.json (git-ignored, automatically loaded by Program.cs).
   * 2. Set the standard ASP.NET Core environment variable: ConnectionStrings__DefaultConnection.
   */
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=basi_dev;Username=basi;Password=basi_dev_password"
  }
}
